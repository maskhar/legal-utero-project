# API_INDONESIA is required at runtime for the server-side trademark search proxy.
# Vite VITE_* variables are embedded at build time and visible to browsers.
# Never put secrets in VITE_* variables.
# Leave GA4 unset until real Measurement ID and privacy notice are approved.
API_INDONESIA=
VITE_GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
